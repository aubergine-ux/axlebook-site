# Axlebook configuration. Copy to `.env` and adjust; every variable is optional.
# Docker Compose picks up `.env` automatically. Full reference: docs/configuration.md.

# ── Server ───────────────────────────────────────────────────────────────────
# Port inside the container (publish it with AXLEBOOK_PORT in docker-compose.yml).
# PORT=8080
# AXLEBOOK_PORT=8080
# The URL people use to reach Axlebook. Recommended behind a reverse proxy, and
# required for single sign-on. It pins the CSRF origin check and builds links in
# notifications.
# BASE_URL=https://cars.example.com
# Trust X-Forwarded-* headers from a reverse proxy (true/false).
# TRUST_PROXY=false
# fatal | error | warn | info | debug | trace | silent
# LOG_LEVEL=info
# Time zone used to decide what "today" is for reminders, e.g. America/Chicago.
# TZ=UTC

# ── Storage ──────────────────────────────────────────────────────────────────
# Where the SQLite database, photos and receipts live (the Docker volume).
# DATA_DIR=/data
# Leave unset for SQLite. Set a Postgres URL to use Postgres instead.
# DATABASE_URL=postgres://axlebook:secret@db:5432/axlebook
# Largest single upload (photos, receipts, backup restores), in megabytes.
# MAX_UPLOAD_MB=25

# ── Accounts ─────────────────────────────────────────────────────────────────
# Create the first admin without the setup screen (only if nobody can sign in yet).
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-to-something-long
# How long a sign-in lasts without being used, in days.
# SESSION_DAYS=30
# Turn off username/password sign-in (when everyone uses single sign-on).
# DISABLE_LOCAL_LOGIN=false

# ── Single sign-on (OIDC: Authentik, Authelia, Keycloak, …) ─────────────────────
# Redirect URI to register with your provider: <BASE_URL>/api/v1/auth/oidc/callback
# OIDC_ISSUER=https://auth.example.com/application/o/axlebook/
# OIDC_CLIENT_ID=axlebook
# OIDC_CLIENT_SECRET=
# OIDC_SCOPES=openid profile email
# Text on the sign-in button: "Continue with …"
# OIDC_LABEL=Single sign-on
# Create an account the first time someone signs in (true/false).
# OIDC_AUTO_CREATE_USERS=true
# Role for those new accounts: admin | editor | viewer
# OIDC_DEFAULT_ROLE=editor
# Members of this group (from the "groups" claim) become admins.
# OIDC_ADMIN_GROUP=axlebook-admins

# ── Email notifications (optional) ─────────────────────────────────────────────
# Needed only for the "Email" notification channel. ntfy, Gotify, Discord and
# webhooks work without it.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Axlebook <axlebook@example.com>
# How often reminders are checked for notifications, in minutes.
# REMINDER_SCAN_INTERVAL_MIN=60

# ── Local assistant (Ollama, optional) ────────────────────────────────────────
# Receipt scan, quick entry, "ask your logbook", spreadsheet import help, tailored
# schedules and tips, from a model running on your own server through Ollama. Requests
# go only to OLLAMA_URL; there's no cloud fallback. Leave it unset and the assistant is off.
# With the bundled service: OLLAMA_URL=http://ollama:11434 and `docker compose --profile ollama up -d`.
# With Ollama already on this machine: http://host.docker.internal:11434 (see docs/configuration.md).
# OLLAMA_URL=http://ollama:11434
# Default model; an admin can pick another installed model in Settings. Receipt scan
# needs one that reads photos (gemma3:4b does).
# OLLAMA_MODEL=gemma3:4b
# Download the model on first start. Set false for offline installs and pull it yourself.
# OLLAMA_PULL=true
# How long to wait for an answer, in seconds (CPU-only machines can be slow).
# OLLAMA_TIMEOUT_SEC=300

# ── Defaults ─────────────────────────────────────────────────────────────────
# Unit system for new accounts: imperial | metric
# DEFAULT_UNIT_SYSTEM=imperial
# ISO 4217 currency code for the instance (admins can change it in Settings).
# DEFAULT_CURRENCY=USD
# Interface language for new accounts.
# DEFAULT_LOCALE=en

# ── Demo ─────────────────────────────────────────────────────────────────────
# Fill the garage with a 2015 Tacoma and a 2018 Civic with a few years of history.
# Runs once. Uses the first admin account, or creates "demo" (password from
# ADMIN_PASSWORD, otherwise "axlebook-demo").
# SEED_DEMO_DATA=false
