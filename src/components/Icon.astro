---
// Kit icons are stroked with currentColor, so they're inlined to follow the text colour.
import fs from 'node:fs';
interface Props {
  name: string;
  class?: string;
}
const { name, class: cls = 'icon' } = Astro.props;
const svg = fs
  .readFileSync(`public/icons/${name}.svg`, 'utf8')
  .replace('<svg ', `<svg class="${cls}" aria-hidden="true" focusable="false" `);
---
<Fragment set:html={svg} />
