---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page doesn’t exist on axlebook.xyz.">
  <div class="wrap nf">
    <p class="mono code">404</p>
    <h1 class="ax-display">That page isn’t here.</h1>
    <p class="lede">It may have moved, or the link may be mistyped.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/">Go to the home page</a>
      <a class="btn" href="/docs/">Read the docs</a>
    </div>
  </div>
</Base>

<style>
  .nf {
    padding: 72px 16px;
  }
  .code {
    font-size: 20px;
    color: var(--ink-muted);
  }
  h1 {
    font-size: 40px;
    line-height: 1.1;
  }
</style>
