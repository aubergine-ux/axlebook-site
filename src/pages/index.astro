---
import Icon from '../components/Icon.astro';
import Shot from '../components/Shot.astro';
import Base from '../layouts/Base.astro';
import { REPO } from '../data/site';

const features = [
  ['fuel', 'Fuel economy you can trust', 'MPG or L/100 km worked out full tank to full tank, so a partial fill or a forgotten fill-up doesn’t wreck the average.'],
  ['reminder', 'Reminders that know the odometer', 'Due by date, by distance, or whichever comes first. Log the job and the next one schedules itself.'],
  ['service', 'Every job, with the receipt', 'Service, repairs, upgrades, fuel and running costs, with tags, notes and the photo or PDF attached.'],
  ['vehicle', 'Cars, bikes, sleds and semis', 'Each kind of vehicle gets its own garage section and schedule. Engine hours and kWh are handled too.'],
  ['reports', 'Reports worth printing', 'Spending by month and category, cost per mile, fuel economy over time, as a page or a CSV.'],
  ['export', 'Bring your spreadsheet', 'Import the .xlsx or .csv you already keep, check a preview, and skip anything that’s already there.'],
];
---
<Base
  title="Every mile, on the record."
  description="Axlebook is a free, self-hosted logbook for your vehicles: fuel economy, maintenance reminders, service records and costs, on your own server."
>
  <section class="hero">
    <svg class="gauge" viewBox="0 0 600 600" aria-hidden="true" focusable="false">
      <g fill="none" stroke="currentColor">
        <circle cx="300" cy="300" r="120" />
        <circle cx="300" cy="300" r="180" />
        <circle cx="300" cy="300" r="240" />
        <circle cx="300" cy="300" r="296" />
      </g>
      <path class="arc" d="M 130 470 A 240 240 0 1 1 470 470" fill="none" stroke-width="6" stroke-linecap="round" />
      <line class="needle" x1="300" y1="300" x2="420" y2="180" stroke-width="8" stroke-linecap="round" />
      <circle class="hub" cx="300" cy="300" r="12" />
    </svg>
    <div class="wrap hero-grid">
      <div>
        <img class="lockup" src="/brand/axlebook-lockup-horizontal-on-dark.svg" alt="Axlebook" width="440" height="96" />
        <h1 class="ax-display">Every mile, on the record.</h1>
        <p class="lede">
          A free, self-hosted logbook for your cars, bikes, sleds and semis: fuel, maintenance, reminders
          and costs, kept on your own server.
        </p>
        <div class="actions">
          <a class="btn btn-primary" href="/docs/#install">Get started</a>
          <a class="btn btn-ghost" href={REPO}>View on GitHub</a>
        </div>
      </div>
      <div class="panel" aria-hidden="true">
        <div class="panel-head">
          <img src="/brand/axlebook-icon-default.svg" alt="" width="72" height="72" />
          <div>
            <p class="panel-title">2015 Toyota Tacoma</p>
            <p class="panel-sub mono">Demo data</p>
          </div>
        </div>
        <p class="panel-label">Odometer</p>
        <p class="readout mono">
          {['0', '8', '5', '9', '4'].map((d) => <span>{d}</span>)}<span class="last">2</span><small>mi</small>
        </p>
        <dl class="panel-stats">
          <div><dt>Average</dt><dd class="mono">19.7 mpg</dd></div>
          <div><dt>Oil change</dt><dd class="status"><span class="dot"></span>Overdue</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="what">
    <div class="wrap">
      <h2 id="what">What it does</h2>
      <div class="grid grid-3">
        {
          features.map(([icon, title, body]) => (
            <div class="card tile">
              <Icon name={icon as string} />
              <h3>{title}</h3>
              <p>{body}</p>
            </div>
          ))
        }
      </div>
      <p class="more"><a href="/features/">All features</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="look">
    <div class="wrap">
      <h2 id="look">A look around</h2>
      <Shot name="garage" alt="The garage: a card for each vehicle with its odometer or hour meter, what’s due next and what it has cost" eager />
      <div class="grid grid-2 pair">
        <figure>
          <Shot name="vehicle" alt="A vehicle’s overview with average economy, cost per mile, what’s coming up and tips" width={800} />
          <figcaption>Each vehicle at a glance.</figcaption>
        </figure>
        <figure>
          <Shot name="reports" alt="Reports: spending by month, where the money went and fuel economy over time" width={800} />
          <figcaption>Where the money went.</figcaption>
        </figure>
      </div>
      <div class="phones">
        <Shot name="phone-log" alt="Logging a fill-up on a phone" width={260} />
        <Shot name="phone-fuel" alt="Fuel history with economy for each fill-up" width={260} />
        <Shot name="phone-reminders" alt="Reminders grouped into overdue and upcoming" width={260} />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="yours">
    <div class="wrap grid grid-3">
      <div>
        <h2 id="yours">Your server, your data</h2>
        <p class="muted">Nothing to sign up for and nothing to pay.</p>
      </div>
      <div class="card">
        <h3>Self-hosted</h3>
        <p>
          It runs on your own machine, from a Raspberry Pi to a home server, with SQLite out of the box or
          Postgres if you prefer. One button downloads a backup of everything.
        </p>
      </div>
      <div class="card">
        <h3>No telemetry, AGPL-3.0</h3>
        <p>
          Axlebook doesn’t phone home. It only contacts other servers you set up yourself, like a
          notification channel or single sign-on. The source is open under the AGPL-3.0.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="install">
    <div class="wrap">
      <h2 id="install">Install in a minute</h2>
      <p>You need Docker with Compose.</p>
      <pre tabindex="0"><code>git clone https://github.com/aubergine-ux/axlebook.git
cd axlebook
docker compose up -d</code></pre>
      <p>Then open <code>http://localhost:8080</code> and create your account.</p>
      <p><a href="/docs/">Read the docs</a> for configuration, backups and running it behind a reverse proxy.</p>
    </div>
  </section>
</Base>

<style>
  .hero {
    /* Graphite in both themes, like the brand guide cover. */
    --focus: #ffab4a;
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(40rem 28rem at 85% 20%, rgba(255, 138, 0, 0.12), transparent 70%),
      linear-gradient(180deg, #1c1f22, #121416);
    color: #f2f4f5;
    padding: 48px 0 56px;
    border-bottom: 1px solid #2a2e33;
  }
  .gauge {
    position: absolute;
    width: 760px;
    max-width: none;
    right: -260px;
    top: -120px;
    color: rgba(255, 255, 255, 0.06);
    pointer-events: none;
  }
  /* On narrow screens the gauge sits behind the text: keep the faint arcs, drop the needle. */
  @media (max-width: 899px) {
    .gauge {
      right: -380px;
      top: -200px;
    }
    .gauge .needle,
    .gauge .hub {
      display: none;
    }
    .gauge .arc {
      opacity: 0.4;
    }
  }
  .gauge .arc {
    stroke: rgba(255, 154, 31, 0.35);
  }
  .gauge .needle {
    stroke: #ff9a1f;
  }
  .gauge .hub {
    fill: #ff9a1f;
  }
  .hero-grid {
    position: relative;
    display: grid;
    gap: 40px;
    align-items: center;
  }
  .lockup {
    width: 240px;
    height: auto;
    margin-bottom: 28px;
  }
  h1 {
    font-size: 40px;
    line-height: 1.05;
    margin-bottom: 16px;
    max-width: 16ch;
  }
  .hero .lede {
    color: #c4cad0;
    margin-bottom: 28px;
  }
  .btn-ghost {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.32);
    color: #f2f4f5;
  }
  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.12);
  }
  .panel {
    justify-self: start;
    width: min(100%, 380px);
    padding: 22px;
    border-radius: var(--radius-xl);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
    backdrop-filter: blur(20px) saturate(150%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.16),
      0 24px 48px rgba(0, 0, 0, 0.35);
  }
  .panel p {
    margin: 0;
  }
  .panel-head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 20px;
  }
  .panel-title {
    font-weight: 700;
  }
  .panel-sub,
  .panel-label,
  dt {
    color: #a3aab1;
    font-size: 14px;
  }
  .readout {
    display: flex;
    align-items: flex-end;
    gap: 5px;
    margin: 6px 0 20px !important;
  }
  .readout span {
    display: grid;
    place-items: center;
    width: 40px;
    height: 52px;
    border-radius: var(--radius-sm);
    background: #2c3136;
    color: #f2f4f5;
    font-size: 30px;
    font-weight: 600;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }
  .readout .last {
    background: #ff9a1f;
    color: #1a1206;
  }
  .readout small {
    margin-left: 4px;
    color: #a3aab1;
    font-size: 16px;
  }
  .panel-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 0;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  dd {
    margin: 2px 0 0;
    font-weight: 600;
  }
  .status {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #ff857a;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #ff857a;
  }
  @media (min-width: 900px) {
    .hero {
      padding: 88px 0 96px;
    }
    .hero-grid {
      grid-template-columns: 1.3fr 1fr;
    }
    .panel {
      justify-self: end;
    }
    h1 {
      font-size: 64px;
    }
    .lockup {
      width: 320px;
    }
  }
  .more {
    margin-top: 20px;
  }
  .pair {
    margin-top: 16px;
  }
  figure {
    margin: 0;
  }
  figcaption {
    margin-top: 8px;
    color: var(--ink-muted);
    font-size: 15px;
  }
  .phones {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 16px;
    max-width: 820px;
  }
</style>
